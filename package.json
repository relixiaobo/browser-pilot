{
  "name": "browser-pilot-cli",
  "version": "0.6.0",
  "description": "CLI tool to control your browser via Chrome DevTools Protocol",
  "repository": "https://github.com/relixiaobo/browser-pilot",
  "type": "module",
  "bin": {
    "bp": "dist/cli.js",
    "browser-pilot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "build:standalone:js": "tsup --config tsup.standalone.config.ts",
    "build:standalone": "npm run build:standalone:js && node scripts/build-standalone.mjs",
    "package:standalone": "node scripts/package-standalone.mjs",
    "package:agent-plugin": "node scripts/package-agent-plugin.mjs",
    "package:release-index": "node scripts/build-release-index.mjs",
    "release:sync-version": "node scripts/sync-release-version.mjs",
    "release:check-version": "node scripts/sync-release-version.mjs --check",
    "version": "node scripts/sync-release-version.mjs && git add -- package-lock.json plugin/package.json plugin/.claude-plugin/plugin.json .claude-plugin/marketplace.json plugin/skills/browser-pilot/compatibility.json",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "lint": "eslint src scripts tests *.ts",
    "test": "tsup && node scripts/run-node-tests.mjs unit && node scripts/run-node-tests.mjs browser && npx playwright test --project core --project compat --project network",
    "test:unit": "tsup && node scripts/run-node-tests.mjs unit",
    "test:browser": "tsup && node scripts/run-node-tests.mjs browser",
    "test:capabilities": "tsup && node scripts/run-node-tests.mjs browser browser-capability-fixtures.test.mjs",
    "test:protocol": "tsup && node --test tests/protocol.test.mjs",
    "test:distribution": "tsup && node scripts/verify-npm-distribution.mjs",
    "test:canary": "tsup && node scripts/run-real-site-canaries.mjs",
    "test:canary:strict": "tsup && node scripts/run-real-site-canaries.mjs --strict",
    "test:integration": "npm run test:canary:strict",
    "test:all": "npm test && npm run test:canary",
    "test:agent": "python3 tests/agent/run.py",
    "test:agent:dry": "python3 tests/agent/run.py --dry-run",
    "test:agent:download": "python3 tests/agent/download_data.py"
  },
  "files": [
    "dist/cli.js",
    "dist/daemon.js",
    "dist/managed-target-janitor.js",
    "docs/architecture/browser-pilot-platform-spec.md",
    "docs/plans/browser-capability-evolution.md",
    "docs/plans/profile-context-routing.md",
    "docs/plans/v0.3.0-stabilization.md",
    "docs/plans/universal-agent-integration.md",
    "docs/releases/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "eslint": "^9.39.5",
    "playwright": "^1.59.1",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [
    "browser",
    "automation",
    "cdp",
    "chrome",
    "cli",
    "devtools"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
